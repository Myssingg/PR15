<Window x:Class="BorDer_PR15_01._01.Autorize"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BorDer_PR15_01._01"
        mc:Ignorable="d"
        Title="Autorize" Height="200" Width="300"
        FontFamily="Tahoma" FontSize="14" ResizeMode="NoResize">
    <Grid Margin="10" Background="Azure" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="textBox_Login" Grid.Column="1" VerticalContentAlignment="Center"/>

        <TextBlock Text="Пароль" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"/>
        <TextBox x:Name="textBox_Password" Grid.Column="1" Grid.Row="1" VerticalContentAlignment="Center"/>

        <Button x:Name="btn_Login" 
                Content="Войти" 
                Background="LawnGreen" 
                Padding="10" 
                Margin="5" 
                Click="btn_Login_Click" 
                Grid.ColumnSpan="2" 
                Grid.Row="3" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"/>
    </Grid>
</Window>
